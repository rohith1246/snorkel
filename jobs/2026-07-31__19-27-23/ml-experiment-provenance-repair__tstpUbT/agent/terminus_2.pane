[?2004l[?2004hroot@154a2b37575e:/app# cat > /app/solution/solve.sh <<'EOF'
[?2004l[?2004h> #!/bin/bash
[?2004l[?2004h> set -euo pipefail
[?2004l[?2004h> 
[?2004l[?2004h> DATA_DIR="/app/data"
[?2004l[?2004h> OUT_DIR="/app/output"
[?2004l[?2004h> mkdir -p "$OUT_DIR"
[?2004l[?2004h> 
[?2004l[?2004h> python3 - <<'PYEOF'
[?2004l[?2004h> import zlib, json, struct
[?2004l[?2004h> 
[?2004l[?2004h> DATA="/app/data"
[?2004l[?2004h> OUT="/app/output/provenance_report.json"
[?2004l[?2004h> 
[?2004l[?2004h> BROKEN_MARKERS = {"", "NULL", "0000000000000000"}
[?2004l[?2004h> ROOT="ROOT"
[?2004l[?2004h> 
[?2004l[?2004h> def cstr(b):
[?2004l[?2004h>     return b.split(b"\x00")[0].decode("ascii", "replace")
[?2004l[?2004h> 
[?2004l[?2004h> # ---- Parse lineage ledger ----
[?2004l[?2004h> lg = open(f"{DATA}/lineage_graph.bin","rb").read()
[?2004l[?2004h> assert lg[:5]==b"EXPRV", "bad lineage magic"
[?2004l[?2004h> version, count = struct.unpack(">HH", lg[5:9])
[?2004l[?2004h> REC=52
[?2004l[?2004h> lineage=[]
[?2004l[?2004h> corrupted=0
[?2004l[?2004h> total=0
[?2004l[?2004h> for i in range(count):
[?2004l[?2004h>     off=12+i*REC
[?2004l[?2004h>     rec=lg[off:off+REC]
[?2004l[?2004h>     if len(rec)<REC: break
[?2004l[?2004h>     total+=1
[?2004l[?2004h>     payload=rec[:48]
[?2004l[?2004h>     stored=int.from_bytes(rec[48:52],"big")
[?2004l[?2004h>     if zlib.crc32(payload)!=stored:
[?2004l[?2004h>         corrupted+=1
[?2004l[?2004h>         continue
[?2004l[?2004h>     run_id=cstr(payload[0:16])
[?2004l[?2004h>     parent=cstr(payload[16:32])
[?2004l[?2004h>     exp_hash=cstr(payload[32:40])
[?2004l[?2004h>     status_code, ts = struct.unpack(">HI", payload[40:46])
[?2004l[?2004h>     lineage.append({"run_id":run_id,"parent_run_id":parent,
[?2004l[?2004h>                     "experiment_hash":exp_hash,"status_code":status_code,
[?2004l[?2004h>                     "timestamp":ts})
[?2004l[?2004h> 
[?2004l[?2004h> # ---- Parse checkpoint dossier ----
[?2004l[?2004h> ck = open(f"{DATA}/checkpoint_dossier.bin","rb").read()
[?2004l[?2004h> assert ck[:5]==b"CKPTR", "bad checkpoint magic"
[?2004l[?2004h> cversion, ccount = struct.unpack(">HH", ck[5:9])
[?2004l[?2004h> CREC=64
[?2004l[?2004h> checkpoints={}
[?2004l[?2004h> for i in range(ccount):
[?2004l[?2004h>     off=12+i*CREC
[?2004l[?2004h>     rec=ck[off:off+CREC]
[?2004l[?2004h>     if len(rec)<CREC: break
[?2004l[?2004h>     payload=rec[:52]
[?2004l[?2004h>     stored=int.from_bytes(rec[52:56],"big")
[?2004l[?2004h>     if zlib.crc32(payload)!=stored:
[?2004l[?2004h>         continue
[?2004l[?2004h>     run_id=cstr(payload[0:16])
[?2004l[?2004h>     inp=cstr(payload[16:34])
[?2004l[?2004h>     out=cstr(payload[34:52])
[?2004l[?2004h>     checkpoints[run_id]={"input":inp,"output":out}
[?2004l[?2004h> 
[?2004l[?2004h> # Only keep lineage runs that also have a valid checkpoint
[?2004l[?2004h> valid_runs={r["run_id"] for r in lineage} & set(checkpoints.keys())
[?2004l[?2004h> lineage=[r for r in lineage if r["run_id"] in valid_runs]
[?2004l[?2004h> 
[?2004l[?2004h> # Build output_checkpoint -> run_id map
[?2004l[?2004h> out_map={}
[?2004l[?2004h> for rid in valid_runs:
[?2004l[?2004h>     out_c=checkpoints[rid]["output"]
[?2004l[?2004h>     if out_c:
[?2004l[?2004h>         out_map[out_c]=rid
[?2004l[?2004h> 
[?2004l[?2004h> # ---- Impute broken parents ----
[?2004l[?2004h> repaired=0
[?2004l[?2004h> for r in lineage:
[?2004l[?2004h>     rid=r["run_id"]
[?2004l[?2004h>     parent=r["parent_run_id"]
[?2004l[?2004h>     if parent in BROKEN_MARKERS:
[?2004l[?2004h>         inp=checkpoints[rid]["input"]
[?2004l[?2004h>         if inp and inp in out_map:
[?2004l[?2004h>             r["parent_run_id"]=out_map[inp]
[?2004l[?2004h>             repaired+=1
[?2004l[?2004h>         else:
[?2004l[?2004h>             r["parent_run_id"]=ROOT
[?2004l[?2004h> 
[?2004l[?2004h> # ---- Topological depth ----
[?2004l[?2004h> by_id={r["run_id"]:r for r in lineage}
[?2004l[?2004h> depth_cache={}
[?2004l[?2004h> def depth(rid, seen=None):
[?2004l[?2004h>     if seen is None: seen=set()
[?2004l[?2004h>     if rid in depth_cache: return depth_cache[rid]
[?2004l[?2004h>     if rid in seen: return 0
[?2004l[?2004h>     seen.add(rid)
[?2004l[?2004h>     r=by_id.get(rid)
[?2004l[?2004h>     if r is None: return 0
[?2004l[?2004h>     p=r["parent_run_id"]
[?2004l[?2004h>     if p==ROOT or p in BROKEN_MARKERS or p not in by_id:
[?2004l[?2004h>         d=0
[?2004l[?2004h>     else:
[?2004l[?2004h>         d=depth(p, seen)+1
[?2004l[?2004h>     depth_cache[rid]=d
[?2004l[?2004h>     return d
[?2004l[?2004h> 
[?2004l[?2004h> tree=[]
[?2004l[?2004h> for r in sorted(lineage, key=lambda x:x["run_id"]):
[?2004l[?2004h>     rid=r["run_id"]
[?2004l[?2004h>     d=depth(rid)
[?2004l[?2004h>     tree.append({
[?2004l[?2004h>         "run_id":rid,
[?2004l[?2004h>         "parent_run_id":r["parent_run_id"],
[?2004l[?2004h>         "depth":d,
[?2004l[?2004h>         "checkpoint_hash":checkpoints[rid]["output"],
[?2004l[?2004h>         "status":"VALID"
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> report={
[?2004l[?2004h>     "status":"SUCCESS",
[?2004l[?2004h>     "summary":{
[?2004l[?2004h>         "total_records":total,
[?2004l[?2004h>         "valid_records":len(lineage),
[?2004l[?2004h>         "repaired_lineages":repaired,
[?2004l[?2004h>         "corrupted_records_excluded":corrupted
[?2004l[?2004h>     },
[?2004l[?2004h>     "provenance_tree":tree
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> with open(OUT,"w") as f:
[?2004l[?2004h>     json.dump(report,f,indent=2)
[?2004l[?2004h>     f.write("\n")
[?2004l[?2004h> print("Wrote", OUT)
[?2004l[?2004h> PYEOF
[?2004l[?2004h> EOF
