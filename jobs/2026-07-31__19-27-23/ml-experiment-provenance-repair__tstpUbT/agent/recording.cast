[99.860429, "i", "cat > /app/solution/solve.sh <<'EOF'\n#!/bin/bash\nset -euo pipefail\n\nDATA_DIR=\"/app/data\"\nOUT_DIR=\"/app/output\"\nmkdir -p \"$OUT_DIR\"\n\npython3 - <<'PYEOF'\nimport zlib, json, struct\n\nDATA=\"/app/data\"\nOUT=\"/app/output/provenance_report.json\"\n\nBROKEN_MARKERS = {\"\", \"NULL\", \"0000000000000000\"}\nROOT=\"ROOT\"\n\ndef cstr(b):\n    return b.split(b\"\\x00\")[0].decode(\"ascii\", \"replace\")\n\n# ---- Parse lineage ledger ----\nlg = open(f\"{DATA}/lineage_graph.bin\",\"rb\").read()\nassert lg[:5]==b\"EXPRV\", \"bad lineage magic\"\nversion, count = struct.unpack(\">HH\", lg[5:9])\nREC=52\nlineage=[]\ncorrupted=0\ntotal=0\nfor i in range(count):\n    off=12+i*REC\n    rec=lg[off:off+REC]\n    if len(rec)<REC: break\n    total+=1\n    payload=rec[:48]\n    stored=int.from_bytes(rec[48:52],\"big\")\n    if zlib.crc32(payload)!=stored:\n        corrupted+=1\n        continue\n    run_id=cstr(payload[0:16])\n    parent=cstr(payload[16:32])\n    exp_hash=cstr(payload[32:40])\n    status_code, ts = struct.unpack(\">HI\", payload[40:46])\n    lineage.append({\"run_id\":run_id,\"p"]
[99.860806, "i", "arent_run_id\":parent,\n                    \"experiment_hash\":exp_hash,\"status_code\":status_code,\n                    \"timestamp\":ts})\n\n# ---- Parse checkpoint dossier ----\nck = open(f\"{DATA}/checkpoint_dossier.bin\",\"rb\").read()\nassert ck[:5]==b\"CKPTR\", \"bad checkpoint magic\"\ncversion, ccount = struct.unpack(\">HH\", ck[5:9])\nCREC=64\ncheckpoints={}\nfor i in range(ccount):\n    off=12+i*CREC\n    rec=ck[off:off+CREC]\n    if len(rec)<CREC: break\n    payload=rec[:52]\n    stored=int.from_bytes(rec[52:56],\"big\")\n    if zlib.crc32(payload)!=stored:\n        continue\n    run_id=cstr(payload[0:16])\n    inp=cstr(payload[16:34])\n    out=cstr(payload[34:52])\n    checkpoints[run_id]={\"input\":inp,\"output\":out}\n\n# Only keep lineage runs that also have a valid checkpoint\nvalid_runs={r[\"run_id\"] for r in lineage} & set(checkpoints.keys())\nlineage=[r for r in lineage if r[\"run_id\"] in valid_runs]\n\n# Build output_checkpoint -> run_id map\nout_map={}\nfor rid in valid_runs:\n    out_c=checkpoints[rid][\"output\"]\n    if out_c:\n        out_"]
[99.862409, "i", "map[out_c]=rid\n\n# ---- Impute broken parents ----\nrepaired=0\nfor r in lineage:\n    rid=r[\"run_id\"]\n    parent=r[\"parent_run_id\"]\n    if parent in BROKEN_MARKERS:\n        inp=checkpoints[rid][\"input\"]\n        if inp and inp in out_map:\n            r[\"parent_run_id\"]=out_map[inp]\n            repaired+=1\n        else:\n            r[\"parent_run_id\"]=ROOT\n\n# ---- Topological depth ----\nby_id={r[\"run_id\"]:r for r in lineage}\ndepth_cache={}\ndef depth(rid, seen=None):\n    if seen is None: seen=set()\n    if rid in depth_cache: return depth_cache[rid]\n    if rid in seen: return 0\n    seen.add(rid)\n    r=by_id.get(rid)\n    if r is None: return 0\n    p=r[\"parent_run_id\"]\n    if p==ROOT or p in BROKEN_MARKERS or p not in by_id:\n        d=0\n    else:\n        d=depth(p, seen)+1\n    depth_cache[rid]=d\n    return d\n\ntree=[]\nfor r in sorted(lineage, key=lambda x:x[\"run_id\"]):\n    rid=r[\"run_id\"]\n    d=depth(rid)\n    tree.append({\n        \"run_id\":rid,\n        \"parent_run_id\":r[\"parent_run_id\"],\n        \"depth\":d,\n        \"chec"]
[99.86246, "o", "cat > /app/solution/solve.sh <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> #!/bin/bash\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.862476, "i", "kpoint_hash\":checkpoints[rid][\"output\"],\n        \"status\":\"VALID\"\n    })\n\nreport={\n    \"status\":\"SUCCESS\",\n    \"summary\":{\n        \"total_records\":total,\n        \"valid_records\":len(lineage),\n        \"repaired_lineages\":repaired,\n        \"corrupted_records_excluded\":corrupted\n    },\n    \"provenance_tree\":tree\n}\n\nwith open(OUT,\"w\") as f:\n    json.dump(report,f,indent=2)\n    f.write(\"\\n\")\nprint(\"Wrote\", OUT)\nPYEOF\nEOF\n"]
