[99.881258, "o", "for r in lineage:\r\n\u001b[?2004l\r\u001b[?2004h>     rid=r[\"run_id\"]\r\n\u001b[?2004l\r\u001b[?2004h>     parent=r[\"parent_run_id\"]\r\n\u001b[?2004l\r\u001b[?2004h>     if parent in BROKEN_MARKERS:\r\n\u001b[?2004l\r\u001b[?2004h>         inp=checkpoints[rid][\"input\"]\r\n\u001b[?2004l\r\u001b[?2004h>         if inp and inp in out_map:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.881877, "o", "            r[\"parent_run_id\"]=out_map[inp]\r\n\u001b[?2004l\r\u001b[?2004h>             repaired+=1\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.882261, "o", "            r[\"parent_run_id\"]=ROOT\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # ---- Topological depth ----\r\n\u001b[?2004l\r\u001b[?2004h> by_id={r[\"run_id\"]:r for r in lineage}\r\n\u001b[?2004l\r\u001b[?2004h> depth_cache={}\r\n\u001b[?2004l\r\u001b[?2004h> def depth(rid, seen=None):\r\n\u001b[?2004l\r\u001b[?2004h>     if seen is None: seen=set()\r\n\u001b[?2004l\r\u001b[?2004h>     if rid in depth_cache: return depth_cache[rid]\r\n\u001b[?2004l\r\u001b[?2004h>     if rid in seen: return 0\r\n\u001b[?2004l\r\u001b[?2004h>     seen.add(rid)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.883444, "o", "    r=by_id.get(rid)\r\n\u001b[?2004l\r\u001b[?2004h>     if r is None: return 0\r\n\u001b[?2004l\r\u001b[?2004h>     p=r[\"parent_run_id\"]\r\n\u001b[?2004l\r\u001b[?2004h>     if p==ROOT or p in BROKEN_MARKERS or p not in by_id:\r\n\u001b[?2004l\r\u001b[?2004h>         d=0\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         d=depth(p, seen)+1\r\n\u001b[?2004l\r\u001b[?2004h>     depth_cache[rid]=d\r\n\u001b[?2004l\r\u001b[?2004h>     return d\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.883718, "o", "tree=[]\r\n\u001b[?2004l\r\u001b[?2004h> for r in sorted(lineage, key=lambda x:x[\"run_id\"]):\r\n\u001b[?2004l\r\u001b[?2004h>     rid=r[\"run_id\"]\r\n\u001b[?2004l\r\u001b[?2004h>     d=depth(rid)\r\n\u001b[?2004l\r\u001b[?2004h>     tree.append({\r\n\u001b[?2004l\r\u001b[?2004h>         \"run_id\":rid,\r\n\u001b[?2004l\r\u001b[?2004h>         \"parent_run_id\":r[\"parent_run_id\"],\r\n\u001b[?2004l\r\u001b[?2004h>         \"depth\":d,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.884093, "o", "        \"checkpoint_hash\":checkpoints[rid][\"output\"],\r\n\u001b[?2004l\r\u001b[?2004h>         \"status\":\"VALID\"\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> report={\r\n\u001b[?2004l\r\u001b[?2004h>     \"status\":\"SUCCESS\",\r\n\u001b[?2004l\r\u001b[?2004h>     \"summary\":{\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.884466, "o", "        \"total_records\":total,\r\n\u001b[?2004l\r\u001b[?2004h>         \"valid_records\":len(lineage),\r\n\u001b[?2004l\r\u001b[?2004h>         \"repaired_lineages\":repaired,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.884818, "o", "        \"corrupted_records_excluded\":corrupted\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>     \"provenance_tree\":tree\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> with open(OUT,\"w\") as f:\r\n"]
[99.885086, "o", "\u001b[?2004l\r\u001b[?2004h>     json.dump(report,f,indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[99.885262, "o", "    f.write(\"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> print(\"Wrote\", OUT)\r\n\u001b[?2004l\r\u001b[?2004h> PYEOF\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
